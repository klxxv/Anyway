{
  "name": "research-canvas-mvp",
  "version": "0.3.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop-web": "npm run dev",
    "build": "vite build",
    "build:desktop": "npm run build",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "desktop:dev": "tauri dev",
    "import:vsix": "python scripts/import_vscode_vsix.py",
    "tauri": "tauri",
    "test": "npm run build && npm run test:core && npm run test:platform && npm run test:workspace && npm run test:sdk && npm run test:native && npm run test:compiler",
    "test:core": "tsx --test tests/research-core.test.ts",
    "test:platform": "tsx --test tests/platform.test.ts tests/plugin-settings-ui.test.ts tests/host-sdk-v2.test.ts tests/vue-ui-ir.test.ts",
    "test:workspace": "tsx --test tests/research-workspace.test.ts tests/workspace-hooks.test.ts tests/pdf-agent-ui.test.ts tests/canvas-diff.test.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:compiler": "tsx --test tests/compiler-parity.test.ts",
    "test:sdk": "tsx --test tests/plugin-sdk.test.ts && cargo check --manifest-path plugins/sdk/rust/Cargo.toml && node scripts/check_cpp_sdk.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern src-tauri/target",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@tabler/icons-vue": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vue-tsc": "^3.0.6",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
