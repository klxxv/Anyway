{
  "name": "research-canvas-mvp",
  "version": "0.3.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:desktop-web": "next dev -p 3000",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:desktop": "cross-env RESEARCH_CANVAS_DESKTOP_BUILD=1 next build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:dev": "tauri dev",
    "tauri": "tauri",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:core && npm run test:platform && npm run test:workspace && npm run test:sdk && npm run test:native && npm run test:compiler",
    "test:core": "tsx --test tests/research-core.test.ts",
    "test:platform": "tsx --test tests/platform.test.ts",
    "test:workspace": "tsx --test tests/research-workspace.test.ts tests/workspace-hooks.test.ts tests/pdf-agent-ui.test.ts tests/canvas-diff.test.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:compiler": "tsx --test tests/compiler-parity.test.ts",
    "test:sdk": "tsx --test tests/plugin-sdk.test.ts && cargo check --manifest-path plugins/sdk/rust/Cargo.toml && node scripts/check_cpp_sdk.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern src-tauri/target",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xyflow/react": "^12.11.2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
