{
  "apiVersion": "researchcanvas.dev/plugin-loading/v1",
  "sourceRoots": {
    "official": "my-plugins",
    "thirdParty": "my-third-plugins"
  },
  "runtimeRoots": {
    "dev": ".plugin-runtime/dev",
    "test": ".plugin-runtime/test",
    "release": ".plugin-runtime/release-staging"
  },
  "desktopDev": {
    "defaultPolicy": "official-bundled-only",
    "packageFiles": [
      "plugins/packages/myc.circuit-orthogonal@1.1.0.myc",
      "plugins/packages/myc.export-suite@1.0.0.myc",
      "plugins/packages/myc.folder-workspaces@1.0.0.myc",
      "plugins/packages/myc.git-workspace@1.2.0.myc"
    ],
    "allowedPluginIds": [
      "myc.circuit-orthogonal",
      "myc.export-suite",
      "myc.folder-workspaces",
      "myc.git-workspace"
    ],
    "developmentPluginSources": {
      "myc.pdf-canvas-agent": "my-plugins/anPdfsolver",
      "anyway.system.ancordis": "my-plugins/ancordis",
      "anyway.anmarket": "my-plugins/anmarket"
    },
    "officialSourceRoots": {
      "myc.pdf-canvas-agent": "my-plugins/anPdfsolver",
      "anyway.system.ancordis": "my-plugins/ancordis",
      "anyway.anmarket": "my-plugins/anmarket"
    },
    "enabledDevelopmentPluginIds": [],
    "freshBuilds": []
  },
  "developmentPlugins": [
    {
      "pluginId": "myc.pdf-canvas-agent",
      "source": "my-plugins/anPdfsolver"
    },
    {
      "pluginId": "anyway.system.ancordis",
      "source": "my-plugins/ancordis"
    },
    {
      "pluginId": "anyway.anmarket",
      "source": "my-plugins/anmarket"
    }
  ],
  "release": {
    "freshBuilds": [
      {
        "pluginId": "myc.pdf-canvas-agent",
        "source": "my-plugins/anPdfsolver"
      }
    ],
    "packageFiles": [
      "plugins/packages/myc.circuit-orthogonal@1.1.0.myc",
      "plugins/packages/myc.export-suite@1.0.0.myc",
      "plugins/packages/myc.folder-workspaces@1.0.0.myc",
      "plugins/packages/myc.git-workspace@1.2.0.myc",
      "plugins/packages/myc.pdf-canvas-agent@0.5.0.myc"
    ]
  }
}
