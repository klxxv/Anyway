{
  "schemaVersion": 1,
  "mode": "agent",
  "agentType": "pdf-canvas",
  "reviewGated": true,
  "capabilities": [
    "agent.pdf.read",
    "agent.graph.patch.propose",
    "agent.review.request"
  ],
  "securityBoundary": {
    "noApiKey": true,
    "apiKeyExposure": "none",
    "noFileHandles": true,
    "noNetwork": true,
    "noGraphStoreWrite": true,
    "hostMediated": true
  },
  "modelConfiguration": {
    "ownership": "host-managed",
    "invocation": "host-model-gateway",
    "settingIds": [
      "api-key",
      "model",
      "thinking"
    ],
    "secretSettingIds": [
      "api-key"
    ],
    "agentReceives": [
      "model",
      "thinking"
    ],
    "agentReceivesPlaintextSecrets": false,
    "credentialPolicy": "The host resolves the API key and never exposes its plaintext to the agent."
  },
  "pipeline": {
    "stages": [
      "validating_file",
      "extracting_text",
      "ocr_optional",
      "building_document_map",
      "extracting_semantics",
      "generating_patch",
      "awaiting_review"
    ],
    "idempotent": true,
    "checkpointEnabled": true
  }
}
