{
  "schemaVersion": 1,
  "mode": "agent",
  "agentType": "pdf-canvas",
  "reviewGated": true,
  "maintainer": "official",
  "extractionSchema": "myc.llm.v4",
  "compiledSchema": "myc.graph-ir.v4",
  "capabilities": [
    "agent.pdf.read",
    "agent.graph.patch.propose",
    "agent.review.request"
  ],
  "securityBoundary": {
    "noApiKey": true,
    "apiKeyExposure": "none",
    "noFileHandles": true,
    "noNetwork": true,
    "noGraphStoreWrite": true,
    "hostMediated": true
  },
  "modelConfiguration": {
    "ownership": "host-managed",
    "invocation": "host-model-gateway",
    "nativeProviderProfile": {
      "id": "kimi-k2.6",
      "declaration": "agent.yml#nativeProvider",
      "requestPolicy": "agent.yml#nativeProvider.requestPolicy",
      "credentialOwnership": "host",
      "reviewGated": true
    },
    "settingIds": [
      "api-key",
      "api-url",
      "api-format",
      "credential-source",
      "credential-env-var",
      "pdf-transport",
      "model",
      "thinking"
    ],
    "secretSettingIds": [
      "api-key"
    ],
    "agentReceives": [
      "model",
      "thinking"
    ],
    "agentReceivesPlaintextSecrets": false,
    "credentialPolicy": "The host resolves the API key and never exposes its plaintext to the agent."
  },
  "pipeline": {
    "stages": [
      "validating_file",
      "extracting_text",
      "ocr_optional",
      "building_document_map",
      "extracting_semantics",
      "compiling_graph_ir",
      "persisting_canvas",
      "generating_patch",
      "awaiting_review"
    ],
    "extractionContract": "myc.llm.v4",
    "transport": "host-bus",
    "hostBus": {
      "compile": "graph.ir.compile",
      "persist": "graph.storage.put",
      "progress": "event.publish",
      "audit": "audit.read"
    },
    "idempotent": true,
    "checkpointEnabled": true
  }
}
