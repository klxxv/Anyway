{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-d-merge.schema.json",
  "title": "PDF Agent Pass D CrossSegmentMergeResult",
  "description": "Schema aligned with semantic_pipeline::ir::CrossSegmentMergeResult.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mergeGroups": { "type": "array", "items": { "$ref": "#/$defs/mergeGroup" } },
    "claimEvidenceBundles": { "type": "array", "items": { "$ref": "#/$defs/claimEvidenceBundle" } },
    "metricAlignment": { "type": "array", "items": { "$ref": "#/$defs/metricAlignment" } },
    "datasetRegistry": { "type": "array", "items": { "$ref": "#/$defs/datasetRegistryEntry" } }
  },
  "required": ["mergeGroups", "claimEvidenceBundles", "metricAlignment", "datasetRegistry"],
  "$defs": {
    "mergeGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalTempId": { "type": "string" },
        "canonicalName": { "type": "string", "minLength": 1 },
        "canonicalDescription": { "type": "string" },
        "mergedTempIds": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "enum": ["same_entity", "alias", "synonym", "abbreviation"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["canonicalTempId", "canonicalName", "canonicalDescription", "mergedTempIds", "reason", "confidence"]
    },
    "claimEvidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimTempId": { "type": "string" },
        "summary": { "type": "string" },
        "evidenceTempIds": { "type": "array", "items": { "type": "string" } },
        "strength": { "type": "string", "enum": ["strong", "moderate", "weak"] },
        "strengthRationale": { "type": "string" }
      },
      "required": ["claimTempId", "summary", "evidenceTempIds", "strength", "strengthRationale"]
    },
    "metricAlignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalMetric": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "unit": { "type": ["string", "null"] }
      },
      "required": ["canonicalMetric", "aliases"]
    },
    "datasetRegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalName": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "description": { "type": ["string", "null"] }
      },
      "required": ["canonicalName", "aliases"]
    }
  }
}
