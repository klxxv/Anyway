{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-e-synthesis.schema.json",
  "title": "PDF Agent Pass E PaperSynthesisResult",
  "description": "Schema aligned with semantic_pipeline::ir::PaperSynthesisResult. conclusionType is intentional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mainConclusions": { "type": "array", "items": { "$ref": "#/$defs/mainConclusion" } },
    "ablationAnalysis": { "type": "array", "items": { "$ref": "#/$defs/ablationAnalysis" } },
    "interactionEffects": { "type": "array", "items": { "$ref": "#/$defs/interactionEffect" } },
    "confounders": { "type": "array", "items": { "$ref": "#/$defs/confounder" } },
    "missingControls": { "type": "array", "items": { "$ref": "#/$defs/missingControl" } },
    "internalConflicts": { "type": "array", "items": { "$ref": "#/$defs/internalConflict" } },
    "synthesisSummary": { "type": "string" }
  },
  "required": ["mainConclusions", "ablationAnalysis", "interactionEffects", "confounders", "missingControls", "internalConflicts", "synthesisSummary"],
  "$defs": {
    "mainConclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempId": { "type": "string" },
        "statement": { "type": "string", "minLength": 1 },
        "supportedBy": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "conclusionType": { "type": ["string", "null"], "enum": ["primary", "secondary", "exploratory", null] }
      },
      "required": ["tempId", "statement", "supportedBy", "confidence"]
    },
    "ablationAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimentTempId": { "type": "string" },
        "ablationType": { "type": "string", "enum": ["component", "hyperparameter", "data", "architecture"] },
        "targetComponent": { "type": "string" },
        "finding": { "type": "string" },
        "impactAssessment": { "type": "string", "enum": ["critical", "moderate", "minor"] }
      },
      "required": ["experimentTempId", "ablationType", "targetComponent", "finding", "impactAssessment"]
    },
    "interactionEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": { "type": "array", "items": { "type": "string" } },
        "claimTempId": { "type": "string" },
        "effectDescription": { "type": "string" },
        "nature": { "type": "string", "enum": ["synergistic", "antagonistic", "conditional"] }
      },
      "required": ["variables", "claimTempId", "effectDescription", "nature"]
    },
    "confounder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableTempId": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["high", "medium", "low"] },
        "reasoning": { "type": "string" }
      },
      "required": ["variableTempId", "riskLevel", "reasoning"]
    },
    "missingControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "recommendedControl": { "type": "string" },
        "affectsClaims": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["description", "recommendedControl", "affectsClaims"]
    },
    "internalConflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimA": { "type": "string" },
        "claimB": { "type": "string" },
        "conflictDescription": { "type": "string" },
        "resolution": { "type": "string", "enum": ["possible", "unresolved"] },
        "resolutionNote": { "type": "string" }
      },
      "required": ["claimA", "claimB", "conflictDescription", "resolution", "resolutionNote"]
    }
  }
}
