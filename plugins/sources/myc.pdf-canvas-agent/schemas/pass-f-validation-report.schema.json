{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-f-validation-report.schema.json",
  "title": "PDF Agent Pass F ValidationReport",
  "description": "Schema aligned with semantic_pipeline::validation::ValidationReport.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "passed": { "type": "boolean" },
    "totalChecks": { "type": "integer", "minimum": 0 },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/validationCheck" } },
    "summary": { "type": "string" }
  },
  "required": ["passed", "totalChecks", "checks", "summary"],
  "$defs": {
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "category": { "type": "string" },
        "passed": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] }
      },
      "required": ["checkId", "category", "passed", "severity", "message"]
    }
  }
}
