{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/agent-candidates.schema.json",
  "title": "PDF Agent AgentCandidates",
  "description": "Merged Pass A-E intermediate representation consumed by Pass F. Item definitions are referenced from the pass schemas.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paperId": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "authors": { "type": "array", "items": { "type": "string" } },
    "year": { "type": ["integer", "null"], "minimum": 0 },
    "doi": { "type": ["string", "null"] },
    "entities": {
      "type": "array",
      "items": { "$ref": "pass-b-entities.schema.json#/$defs/extractedEntity" }
    },
    "variableRegistry": {
      "type": "array",
      "items": { "$ref": "pass-c-variable-fission.schema.json#/$defs/variableRegistryEntry" }
    },
    "experimentMatrix": {
      "type": "array",
      "items": { "$ref": "pass-c-variable-fission.schema.json#/$defs/experimentMatrixEntry" }
    },
    "mergeGroups": {
      "type": "array",
      "items": { "$ref": "pass-d-merge.schema.json#/$defs/mergeGroup" }
    },
    "claimEvidenceBundles": {
      "type": "array",
      "items": { "$ref": "pass-d-merge.schema.json#/$defs/claimEvidenceBundle" }
    },
    "metricAlignment": {
      "type": "array",
      "items": { "$ref": "pass-d-merge.schema.json#/$defs/metricAlignment" }
    },
    "datasetRegistry": {
      "type": "array",
      "items": { "$ref": "pass-d-merge.schema.json#/$defs/datasetRegistryEntry" }
    },
    "mainConclusions": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/mainConclusion" }
    },
    "ablationAnalysis": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/ablationAnalysis" }
    },
    "interactionEffects": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/interactionEffect" }
    },
    "confounders": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/confounder" }
    },
    "missingControls": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/missingControl" }
    },
    "internalConflicts": {
      "type": "array",
      "items": { "$ref": "pass-e-synthesis.schema.json#/$defs/internalConflict" }
    },
    "synthesisSummary": { "type": ["string", "null"] }
  },
  "required": [
    "paperId",
    "authors",
    "entities",
    "variableRegistry",
    "experimentMatrix",
    "mergeGroups",
    "claimEvidenceBundles",
    "metricAlignment",
    "datasetRegistry",
    "mainConclusions",
    "ablationAnalysis",
    "interactionEffects",
    "confounders",
    "missingControls",
    "internalConflicts"
  ]
}
