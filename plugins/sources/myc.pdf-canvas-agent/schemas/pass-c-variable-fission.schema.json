{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-c-variable-fission.schema.json",
  "title": "PDF Agent Pass C VariableFissionResult",
  "description": "Schema aligned with semantic_pipeline::ir::VariableFissionResult.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentMatrix": { "type": "array", "items": { "$ref": "#/$defs/experimentMatrixEntry" } },
    "variableRegistry": { "type": "array", "items": { "$ref": "#/$defs/variableRegistryEntry" } }
  },
  "required": ["experimentMatrix", "variableRegistry"],
  "$defs": {
    "variableDomain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["categorical", "continuous", "discrete"] },
        "values": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] }
      },
      "required": ["type"]
    },
    "variableRoleEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableTempId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "levels": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "measurement": { "type": ["string", "null"] },
        "domain": { "$ref": "#/$defs/variableDomain" }
      },
      "required": ["variableTempId", "name", "domain"]
    },
    "controlEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableTempId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "heldAt": { "type": ["string", "null"] }
      },
      "required": ["variableTempId", "name"]
    },
    "moderatorEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableTempId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "interactionWith": { "type": ["string", "null"] }
      },
      "required": ["variableTempId", "name"]
    },
    "mediatorEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableTempId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "pathway": { "type": ["string", "null"] }
      },
      "required": ["variableTempId", "name"]
    },
    "sampleInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": ["number", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "conditionEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "ivSettings": {}
      },
      "required": ["label", "ivSettings"]
    },
    "experimentMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimentTempId": { "type": "string" },
        "design": { "type": ["string", "null"] },
        "ivs": { "type": "array", "items": { "$ref": "#/$defs/variableRoleEntry" } },
        "dvs": { "type": "array", "items": { "$ref": "#/$defs/variableRoleEntry" } },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/controlEntry" } },
        "moderators": { "type": "array", "items": { "$ref": "#/$defs/moderatorEntry" } },
        "mediators": { "type": "array", "items": { "$ref": "#/$defs/mediatorEntry" } },
        "sample": { "anyOf": [{ "$ref": "#/$defs/sampleInfo" }, { "type": "null" }] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/conditionEntry" } }
      },
      "required": ["experimentTempId", "ivs", "dvs", "controls", "moderators", "mediators", "conditions"]
    },
    "variableRegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "domain": { "$ref": "#/$defs/variableDomain" },
        "role": { "type": "string", "enum": ["independent", "dependent", "controlled", "moderator", "mediator"] },
        "measuredAs": { "type": ["string", "null"] },
        "isNew": { "type": "boolean", "default": false }
      },
      "required": ["tempId", "name", "aliases", "domain", "role"]
    }
  }
}
