{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-b-entities.schema.json",
  "title": "PDF Agent Pass B EntityExtraction",
  "description": "Schema aligned with semantic_pipeline::ir::EntityExtraction.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entities": { "type": "array", "items": { "$ref": "#/$defs/extractedEntity" } },
    "meta": { "$ref": "#/$defs/entityExtractionMeta" }
  },
  "required": ["entities", "meta"],
  "$defs": {
    "anchorRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionId": { "type": "string", "minLength": 1 },
        "paragraphId": { "type": "string", "minLength": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" }
      },
      "required": ["sectionId", "paragraphId", "startOffset", "endOffset", "quote"]
    },
    "entityAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimType": { "type": ["string", "null"] },
        "variableType": { "type": ["string", "null"] },
        "methodology": { "type": ["string", "null"] },
        "sampleSize": { "type": ["number", "null"] },
        "pValue": { "type": ["number", "null"] },
        "effectSize": { "type": ["number", "null"] }
      }
    },
    "extractedEntity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempId": { "type": "string", "pattern": "^(q|h|cl|m|exp|r|ev|v)[0-9]+$" },
        "kind": {
          "type": "string",
          "enum": ["question", "hypothesis", "claim", "method", "experiment", "result", "evidence", "variable"]
        },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "anchors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/anchorRef" } },
        "attributes": { "$ref": "#/$defs/entityAttributes" }
      },
      "required": ["tempId", "kind", "label", "text", "confidence", "anchors", "attributes"]
    },
    "entityExtractionMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionCoverage": { "type": "array", "items": { "type": "string" } },
        "totalEntities": { "type": "integer", "minimum": 0 }
      },
      "required": ["sectionCoverage", "totalEntities"]
    }
  }
}
