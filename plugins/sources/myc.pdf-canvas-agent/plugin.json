{
  "name": "myc.pdf-canvas-agent",
  "version": "0.3.2",
  "publisher": "Research Canvas",
  "developer": "Agent Platform Team",
  "developerId": "8bca4aed-e0ab-43c5-89ee-e2bcaf7f0e31",
  "description": "Extracts a DocumentMap from a research PDF, turns it into semantic structure, and proposes a review-gated GraphPatch. The agent never owns API keys, filesystem handles, network access, or graph-store write permissions.\n",
  "license": "MIT",
  "categories": [
    "AgentPlugin"
  ],
  "main": "agent-manifest.json",
  "engines": {
    "engine": "host-mediated"
  },
  "capabilities": [
    "agent.pdf.read",
    "agent.graph.patch.propose",
    "agent.review.request"
  ],
  "permissions": [],
  "contributes": {
    "configuration": {
      "settings": [
        {
          "id": "api-key",
          "label": "API key",
          "labelKey": "settings.apiKey.label",
          "description": "The host keeps this API key for the current session and never exposes it to the agent.",
          "descriptionKey": "settings.apiKey.description",
          "type": "text",
          "secret": true,
          "required": false,
          "placeholder": "Paste your API key",
          "placeholderKey": "settings.apiKey.placeholder",
          "group": "model"
        },
        {
          "id": "api-url",
          "label": "API URL",
          "labelKey": "settings.apiUrl.label",
          "description": "Enter the Moonshot base URL that matches the parser backend and the region where the API key was created.",
          "descriptionKey": "settings.apiUrl.description",
          "type": "text",
          "required": true,
          "placeholder": "https://api.moonshot.cn/v1",
          "placeholderKey": "settings.apiUrl.placeholder",
          "group": "connection"
        },
        {
          "id": "api-format",
          "label": "Parser backend",
          "labelKey": "settings.apiFormat.label",
          "description": "Select both the request protocol and streaming response parser. OpenAI uses /v1; Anthropic uses /anthropic.",
          "descriptionKey": "settings.apiFormat.description",
          "type": "select",
          "required": true,
          "default": "openai",
          "group": "connection",
          "options": [
            {
              "value": "openai",
              "label": "OpenAI-compatible",
              "labelKey": "settings.apiFormat.options.openai"
            },
            {
              "value": "anthropic",
              "label": "Anthropic-compatible",
              "labelKey": "settings.apiFormat.options.anthropic"
            }
          ]
        },
        {
          "id": "credential-source",
          "label": "Credential source",
          "labelKey": "settings.credentialSource.label",
          "description": "Choose where the host should read the API key.",
          "descriptionKey": "settings.credentialSource.description",
          "type": "select",
          "required": true,
          "default": "host-secret",
          "group": "connection",
          "options": [
            {
              "value": "environment",
              "label": "Local environment variable",
              "labelKey": "settings.credentialSource.options.environment"
            },
            {
              "value": "host-secret",
              "label": "API key entered in this app",
              "labelKey": "settings.credentialSource.options.hostSecret"
            }
          ]
        },
        {
          "id": "credential-env-var",
          "label": "Environment variable name",
          "labelKey": "settings.credentialEnvVar.label",
          "description": "Only the variable name is stored; its value stays in the host process.",
          "descriptionKey": "settings.credentialEnvVar.description",
          "type": "text",
          "required": true,
          "default": "MOONSHOT_API_KEY",
          "placeholder": "MOONSHOT_API_KEY",
          "placeholderKey": "settings.credentialEnvVar.placeholder",
          "group": "connection"
        },
        {
          "id": "pdf-transport",
          "label": "PDF extraction",
          "labelKey": "settings.pdfTransport.label",
          "description": "Local extraction keeps the PDF on this device. Kimi Files uploads it to Moonshot.",
          "descriptionKey": "settings.pdfTransport.description",
          "type": "select",
          "required": true,
          "default": "local-text",
          "group": "connection",
          "options": [
            {
              "value": "local-text",
              "label": "Extract text on this device",
              "labelKey": "settings.pdfTransport.options.localText"
            },
            {
              "value": "kimi-file-extract",
              "label": "Use Kimi Files (uploads the PDF)",
              "labelKey": "settings.pdfTransport.options.kimiFiles"
            }
          ]
        },
        {
          "id": "model",
          "label": "Model",
          "labelKey": "settings.model.label",
          "description": "Kimi K2.6 analyzes the extracted PDF text and produces the structured canvas result.",
          "descriptionKey": "settings.model.description",
          "type": "text",
          "required": true,
          "default": "kimi-k2.6",
          "placeholder": "kimi-k2.6",
          "placeholderKey": "settings.model.placeholder",
          "group": "model"
        },
        {
          "id": "thinking",
          "label": "Thinking mode",
          "labelKey": "settings.thinking.label",
          "description": "Kimi K2.6 supports thinking as enabled or disabled; it does not use reasoning-effort levels.",
          "descriptionKey": "settings.thinking.description",
          "type": "select",
          "required": true,
          "default": "enabled",
          "group": "model",
          "options": [
            {
              "value": "enabled",
              "label": "Enabled",
              "labelKey": "settings.thinking.options.enabled"
            },
            {
              "value": "disabled",
              "label": "Disabled",
              "labelKey": "settings.thinking.options.disabled"
            }
          ]
        },
        {
          "id": "public-progress",
          "label": "Public analysis progress",
          "labelKey": "settings.publicProgress.label",
          "description": "Ask the model to emit short user-visible progress summaries. These are ordinary output, never hidden chain-of-thought.",
          "descriptionKey": "settings.publicProgress.description",
          "type": "select",
          "required": true,
          "default": "disabled",
          "group": "advanced",
          "options": [
            {
              "value": "disabled",
              "label": "Disabled",
              "labelKey": "settings.publicProgress.options.disabled"
            },
            {
              "value": "enabled",
              "label": "Enabled",
              "labelKey": "settings.publicProgress.options.enabled"
            }
          ]
        }
      ],
      "connections": [
        {
          "id": "provider",
          "label": "AI provider",
          "labelKey": "connections.provider.label",
          "description": "Connect the PDF agent to the selected AI service.",
          "descriptionKey": "connections.provider.description",
          "urlSettingId": "api-url",
          "formatSettingId": "api-format",
          "modelSettingId": "model",
          "credentialSourceSettingId": "credential-source",
          "credentialEnvVarSettingId": "credential-env-var",
          "nativeProviderProfile": "kimi-k2.6",
          "apiKey": {
            "source": "environment",
            "name": "MOONSHOT_API_KEY",
            "fallbackSettingId": "api-key"
          },
          "testActions": [
            {
              "id": "test-connection",
              "kind": "connection",
              "label": "Test AI connection",
              "labelKey": "actions.testConnection.label",
              "description": "Send a minimal text request. No PDF or file is uploaded.",
              "descriptionKey": "actions.testConnection.description",
              "input": {
                "type": "text",
                "fileUpload": "never"
              }
            },
            {
              "id": "test-pdf-extraction",
              "kind": "pdf-extraction",
              "label": "Test PDF extraction",
              "labelKey": "actions.testPdfExtraction.label",
              "description": "Use the built-in non-empty test PDF. It may be uploaded when remote extraction is selected.",
              "descriptionKey": "actions.testPdfExtraction.description",
              "input": {
                "type": "bundled-pdf",
                "fixture": "host-minimal-pdf-v1",
                "fileUpload": "may-upload"
              }
            }
          ]
        }
      ]
    }
  },
  "privateI18n": {
    "defaultLocale": "en",
    "locales": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "displayName": "PDF Canvas Agent"
}
