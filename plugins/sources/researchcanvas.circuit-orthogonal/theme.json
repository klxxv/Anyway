{
  "id": "researchcanvas.circuit-orthogonal",
  "name": "Circuit Orthogonal",
  "publisher": "Research Canvas Community",
  "version": "1.1.0",
  "description": "Blueprint-inspired theme with crisp 90-degree routing for experiment and evidence maps.",
  "developer": "Research Canvas Visual Systems",
  "source": "myc",
  "colors": {
    "app": "#0d1117",
    "panel": "#161b22",
    "canvas": "#0f1419",
    "text": "#c9d1d9",
    "muted": "#6e7681",
    "accent": "#61afef",
    "border": "#30363d"
  },
  "components": {
    "toast": {
      "background": "#1c2128",
      "border": "#30363d",
      "text": "#c9d1d9",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.32)"
    },
    "miniMap": {
      "background": "#161b22",
      "border": "#30363d",
      "mask": "rgba(15, 20, 25, 0.72)",
      "selectedNode": "#61afef",
      "evidenceNode": "#56b6c2",
      "node": "#6e7681",
      "relation": "#484f58",
      "showRelations": true
    },
    "radialMenu": {
      "background": "#161b22",
      "border": "#484f58",
      "divider": "#30363d",
      "text": "#c9d1d9",
      "active": "#61afef",
      "centerBackground": "#0f1419",
      "centerText": "#61afef",
      "shadow": "0 12px 34px rgba(0, 0, 0, 0.38)",
      "activeShadow": "rgba(97, 175, 239, 0.28)"
    }
  },
  "edgeStyle": {
    "routing": "orthogonal",
    "stroke": {
      "color": "#61afef",
      "width": 1.8,
      "selectedWidth": 3,
      "opacity": 0.94,
      "cornerRadius": 12,
      "offset": 26
    },
    "relations": {
      "supports": {
        "color": "#56b6c2",
        "width": 2.1
      },
      "contradicts": {
        "color": "#e06c75",
        "width": 2.1,
        "dash": [8, 4]
      },
      "depends_on": {
        "color": "#61afef",
        "width": 1.8
      },
      "controls": {
        "color": "#6e7681",
        "dash": [3, 4]
      },
      "measures": {
        "color": "#c678dd",
        "width": 1.9
      }
    },
    "marker": {
      "type": "closed-arrow",
      "size": 16
    }
  }
}
