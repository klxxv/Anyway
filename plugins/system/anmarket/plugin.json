{
  "name": "anyway.anmarket",
  "displayName": "AnMarket",
  "version": "0.1.0",
  "publisher": "Anyway Core Team",
  "developer": "Anyway Core Team",
  "description": "Official supply-chain registry, analysis, reputation, policy, and update coordinator.",
  "license": "MIT",
  "categories": [
    "SystemPlugin"
  ],
  "main": "index.ts",
  "engines": {
    "engine": "ancordis"
  },
  "capabilities": [
    "registry.provider",
    "supplychain.analyzer",
    "supplychain.reputation",
    "supplychain.policy-advisor",
    "vue-ir.contribute"
  ],
  "permissions": [],
  "contributes": {
    "uiIr": {
      "slots": [
        "market.registry",
        "market.install",
        "market.scan-report",
        "market.update-history"
      ]
    }
  },
  "provides": {
    "services": [
      "RegistryProvider",
      "AnalyzerProvider",
      "ReputationProvider",
      "PolicyAdvisor"
    ],
    "events": []
  },
  "trustClass": "official-system",
  "security": {
    "kernelEnforced": [
      "trust-root",
      "subject-hash",
      "signature-verification",
      "quarantine-install",
      "permission-grant",
      "atomic-activation",
      "rollback"
    ],
    "providerRestrictions": {
      "analyzerInput": "read-only-BlobRef",
      "analyzerCanInstall": false,
      "analyzerCanApprove": false,
      "policyAdvisorCanGrant": false
    }
  }
}
