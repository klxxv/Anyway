# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# build artifacts
/dist/
/build/
/.wrangler/
/next-env.d.ts
*.tsbuildinfo

# runtime artifacts
/output/
/outputs/
/work/
/.playwright-cli/
/.claude_resources.json

# tauri / rust
/src-tauri/target/
/src-tauri/bin/
/src-tauri/gen/
/plugins/sdk/rust/target/

# plugin installed state (verified at install; regenerated)
/plugins/installed/*
!/plugins/installed/.gitkeep

# secrets — the app generates Ed25519 keys; never commit them
.env
.env.*
*.pem
*.key
*.p12
/.ssh/
id_ed25519*
id_ed25519.pub

# internal planning/audit docs — not exposed (v3 design is not yet public)
/docs/*
!/docs/module-boundaries.md
!/docs/architecture/

# misc
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor / ide
/.idea/
/.vscode/

# vercel
.vercel

# rust workspace crates build output
crates/*/target/
