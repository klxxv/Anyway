# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build artifacts
/dist/
/build/
*.tsbuildinfo

# runtime artifacts
/output/
/outputs/
/work/
/.playwright-cli/
/.claude_resources.json

# tauri / rust
/src-tauri/target/
/src-tauri/bin/
/src-tauri/gen/
/plugins/sdk/rust/target/

# plugin installed state (verified at install; regenerated)
/plugins/installed/*
!/plugins/installed/.gitkeep

# separated local plugin packages and generated runtimes
/my-third-plugins/
my-plugins/*/dist/
/.plugin-runtime/
/plugin-runtime/

# secrets — the app generates Ed25519 keys; never commit them
.env
.env.*
*.pem
*.key
*.p12
/.ssh/
id_ed25519*
id_ed25519.pub

# internal planning/audit docs — not exposed (v3 design is not yet public)
/docs/*
!/docs/module-boundaries.md
!/docs/architecture/
!/docs/schema-v4/
!/docs/vue-migration-handoff.md
!/docs/sse-bp-canvas.png
!/docs/sse-canvas-diff.png

# external reference examples (not core app)
/examples/

# standalone demos
/demos/

# parallel-session scratch (DSH plugin port built by another workspace session)
/dsh-anyway/

# auto-generated docs
/merge-roadmap.md
/design-qa.md

# misc
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor / ide
/.idea/
/.vscode/

# vercel
.vercel

# rust workspace crates build output
/target/
crates/*/target/

# python caches
__pycache__/
*.py[cod]

# opencode session handoff (local context, never published)
/OPENCODE_HANDOFF.md
