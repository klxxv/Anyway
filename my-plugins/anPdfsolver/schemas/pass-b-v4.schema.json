{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchcanvas.dev/plugins/myc.pdf-canvas-agent/schemas/pass-b-v4.schema.json",
  "title": "PDF Agent Pass B myc.llm.v4 fragment",
  "description": "Per-section ExtractionV3 fragment (snake_case, mirroring anyway-schema-v4 extract.rs). The root schema_version and document object are added by Pass E.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "section_id": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "contexts": { "type": "array", "items": { "$ref": "#/$defs/context" } },
    "axiom_sets": { "type": "array", "items": { "$ref": "#/$defs/axiomSet" } },
    "experiments": { "type": "array", "items": { "$ref": "#/$defs/experiment" } },
    "operator_candidates": { "type": "array", "items": { "$ref": "#/$defs/operatorCandidate" } },
    "abstraction_candidates": { "type": "array", "items": { "$ref": "#/$defs/abstractionCandidate" } }
  },
  "required": [
    "evidence",
    "variables",
    "contexts",
    "axiom_sets",
    "experiments",
    "operator_candidates",
    "abstraction_candidates"
  ],
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["supported", "ambiguous", "unsupported"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["status", "confidence"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/evidenceLocation" },
        "text_span": { "type": "string" },
        "verification": { "$ref": "#/$defs/verification" }
      },
      "required": ["id", "location", "text_span", "verification"]
    },
    "evidenceLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 0 },
        "section": { "type": "string" },
        "paragraph": { "type": "integer", "minimum": 0 },
        "table": { "type": "string" },
        "figure": { "type": "string" },
        "equation": { "type": "string" }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "concept_id": { "type": "string", "minLength": 1 },
        "value_type": { "enum": ["bool", "number", "expression"] },
        "observed": { "type": "boolean" },
        "value": true,
        "unit_raw": { "type": ["string", "null"] },
        "expression_raw": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "concept_id", "value_type", "observed", "value", "unit_raw", "expression_raw"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "variable_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id"]
    },
    "axiomSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "constraint_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id"]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "context_ref": { "type": ["string", "null"] },
        "axiom_set_ref": { "type": ["string", "null"] },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
        "comparisons": { "type": "array", "items": { "$ref": "#/$defs/stateComparison" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "states", "comparisons"]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["baseline", "proposed", "ablation", "control", "variant", "reference", null] },
        "variable_refs": { "type": "array", "items": { "type": "string" } },
        "result_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id"]
    },
    "stateComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_state": { "type": "string", "minLength": 1 },
        "to_state": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["from_state", "to_state"]
    },
    "operatorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["T", "K", "I", "M", "Q"] },
        "input_refs": { "type": "array", "items": { "type": "string" } },
        "output_refs": { "type": "array", "items": { "type": "string" } },
        "payload": true,
        "context_ref": { "type": ["string", "null"] },
        "axiom_set_ref": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "verification": { "$ref": "#/$defs/verification" }
      },
      "required": ["id", "operator", "verification"]
    },
    "abstractionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input_concept_ids": { "type": "array", "items": { "type": "string" } },
        "proposed_concept_id": { "type": "string", "minLength": 1 },
        "rationale_evidence_refs": { "type": "array", "items": { "type": "string" } },
        "status": { "const": "candidate" }
      },
      "required": ["id", "proposed_concept_id", "status"]
    }
  }
}
